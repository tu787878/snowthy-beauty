{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snowthy-beauty",
  "compatibility_date": "2026-05-22",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snowthy-content",
      "database_id": "local-development"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
